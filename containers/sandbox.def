# The agent sandbox image: a Python runtime and prime-agent, with nothing of this project inside.
#
# Build from the repo root, on a machine with network access (about ten minutes):
#
#     apptainer build --fakeroot <storage_dir>/containers/sandbox.sif containers/sandbox.def
#     bash containers/verify_sandbox.sh <storage_dir>/containers/sandbox.sif
#
# Everything is pinned so that two builds give the same software: the base image by digest
# (Apptainer rejects a reference with both a tag and a digest), and the rest in versions.env.
# The installer is vendored and its hash is checked below; it downloads the prime-agent payload
# and verifies that itself.
#
# prime-agent builds a Python "kernel" venv on first use, unpinned and over the network. The
# sandbox has no network, so the kernel is built here instead, at the runtime home path
# (/home/agent) so its absolute paths stay valid, then kept at /opt/pa-kernel/seed-venv.
# prime_agent_wrapper.sh copies it into each fresh agent home, where it must be writable.

Bootstrap: docker
From: python@sha256:cad37dd20c7cac861af9003af8796d03ea7a998ec1e3a664429740fc9d7d2691

%files
    containers/versions.env /opt/build/versions.env
    containers/prime_agent_install.sh /opt/build/install.sh
    containers/kernel_constraints.txt /opt/build/kernel_constraints.txt
    containers/kernel_skills.json /opt/build/kernel_skills.json
    containers/seed_kernel_skills.py /opt/build/seed_kernel_skills.py
    containers/prime_agent_wrapper.sh /opt/sandbox/bin/prime-agent
    containers/netbridge.py /opt/sandbox/bin/netbridge.py
    containers/sandbox_run.sh /opt/sandbox/bin/sandbox-run

%post
    set -eux
    . /opt/build/versions.env
    echo "$INSTALLER_SHA256  /opt/build/install.sh" | sha256sum -c -

    # The image is read-only at runtime, so the binary goes under /opt rather than ~/.local.
    export PRIME_AGENT_RUST_PREFIX=/opt/pa
    export PRIME_AGENT_VERSION
    export PRIME_AGENT_TELEMETRY=0 DO_NOT_TRACK=1

    python -m pip install --no-cache-dir "uv==$UV_VERSION"

    # prime-agent strips UV_PYTHON_INSTALL_DIR before running uv but not XDG_DATA_HOME, so the
    # pinned interpreter is put where uv looks by default; its own "install 3.11" is then a no-op.
    export XDG_DATA_HOME=/opt/pa-kernel/data
    export UV_CACHE_DIR=/tmp/uv-build-cache
    export UV_CONSTRAINT=/opt/build/kernel_constraints.txt
    uv python install "$KERNEL_PYTHON_VERSION"

    export HOME=/home/agent
    mkdir -p "$HOME" /opt/pa
    sh /opt/build/install.sh

    # The installer only warns if the kernel fails to build; here that is a broken image.
    kernel="$HOME/.prime/agent/kernel-venv"
    /opt/pa/bin/prime-agent --version | grep -qF "$PRIME_AGENT_VERSION"
    "$kernel/bin/python" -c "import rlm, dill, numpy, pandas, requests"
    "$kernel/bin/python" --version | grep -qx "Python $KERNEL_PYTHON_VERSION"
    grep -qx "home = /opt/pa-kernel/data/uv/python/.*" "$kernel/pyvenv.cfg"

    python /opt/build/seed_kernel_skills.py "$kernel" \
        /opt/build/kernel_skills.json /opt/pa/share/prime-agent/prime-agent-runtime

    mv "$kernel" /opt/pa-kernel/seed-venv
    uv pip freeze --python /opt/pa-kernel/seed-venv/bin/python > /opt/pa-kernel/freeze.txt
    chmod 0755 /opt/sandbox/bin/prime-agent /opt/sandbox/bin/sandbox-run

    # Keep only the interpreter from the build data home, and nothing from the build HOME.
    find "$XDG_DATA_HOME" -mindepth 1 -maxdepth 1 ! -name uv -exec rm -rf {} +
    find "$XDG_DATA_HOME/uv" -mindepth 1 -maxdepth 1 ! -name python -exec rm -rf {} +
    rm -rf /opt/build "$HOME" "$UV_CACHE_DIR"

    {
        echo "prime_agent.version $PRIME_AGENT_VERSION"
        echo "prime_agent.sha256 $PRIME_AGENT_SHA256"
        echo "installer.sha256 $INSTALLER_SHA256"
        echo "kernel.uv $UV_VERSION"
        echo "kernel.python $KERNEL_PYTHON_VERSION"
    } >> "${APPTAINER_LABELS:-$SINGULARITY_LABELS}"

%environment
    export PATH=/opt/sandbox/bin:/opt/pa/bin:$PATH
    export PRIME_AGENT_TELEMETRY=0
    export DO_NOT_TRACK=1

%labels
    base.digest sha256:cad37dd20c7cac861af9003af8796d03ea7a998ec1e3a664429740fc9d7d2691
    sandbox.entry /opt/sandbox/bin/sandbox-run

%help
    The agent sandbox for GameBoyWorlds evaluation runs. Launch it with containers/run_sandbox.sh.

    prime-agent is on PATH. Its state (~/.prime) is not in the image: it lives in the writable
    agent home mounted at /home/agent, one per run. The workspace is mounted at /work.

    Run with --net --network none. `sandbox-run` bridges the Unix sockets named in
    SANDBOX_BRIDGE (the env server and the model gateway) onto the sandbox's private loopback;
    those are its only ways out, and the API key stays on the host.
